    25	
    26	static void usage(int status) {
    27	  fprintf(stderr, "usage: cc [-E] [-I<dir>] [-D<macro>[=val]] [-mstack=<bytes>] [-mmaxpages=<n>] -o <out.wasm> <input.c>\n");
    28	  exit(status);
    29	}
    30	
    31	static void parse_args(int argc, char **argv) {
    32	  for (int i = 1; i < argc; i++) {
    33	    if (!strcmp(argv[i], "-o")) { if (!argv[++i]) usage(1); opt_o = argv[i]; continue; }
    34	    if (!strncmp(argv[i], "-o", 2)) { opt_o = argv[i] + 2; continue; }
    35	    if (!strcmp(argv[i], "-E")) { opt_E = true; continue; }
    36	    if (!strcmp(argv[i], "-I")) { if (!argv[++i]) usage(1); strarray_push(&include_paths, argv[i]); continue; }
    37	    if (!strncmp(argv[i], "-I", 2)) { strarray_push(&include_paths, argv[i] + 2); continue; }
    38	    if (!strcmp(argv[i], "-D")) { if (!argv[++i]) usage(1); define_arg(argv[i]); continue; }
    39	    if (!strncmp(argv[i], "-D", 2)) { define_arg(argv[i] + 2); continue; }
    40	    if (!strncmp(argv[i], "-mstack=", 8)) { opt_stack_size = atoi(argv[i] + 8); continue; }
    41	    if (!strncmp(argv[i], "-mmaxpages=", 11)) { opt_max_pages = atoi(argv[i] + 11); continue; }
    42	    if (!strcmp(argv[i], "--help")) usage(0);
    43	    if (argv[i][0] == '-' && argv[i][1]) error("unknown argument: %s", argv[i]);
    44	    if (input_path) error("only one input file is supported");
    45	    input_path = argv[i];
    46	  }
    47	  if (!input_path) error("no input file");
    48	}
    49	
    50	static void print_tokens(Token *tok) {
    51	  int line = 1;
    52	  for (; tok->kind != TK_EOF; tok = tok->next) {
    53	    if (line > 1 && tok->at_bol) printf("\n");
    54	    if (tok->has_space && !tok->at_bol) printf(" ");
    55	    printf("%.*s", tok->len, tok->loc);
    56	    line++;
    57	  }
    58	  printf("\n");
    59	}
    60	
    61	int main(int argc, char **argv) {
    62	  init_macros();
    63	  parse_args(argc, argv);
    64	  base_file = input_path;
    65	
    66	  Token *tok = tokenize_file(input_path);
    67	  if (!tok) error("%s: %s", input_path, strerror(errno));
    68	  tok = preprocess(tok);
    69	
    70	  if (opt_E) { print_tokens(tok); return 0; }
    71	
    72	  Obj *prog = parse(tok);
    73	  FILE *out = opt_o ? fopen(opt_o, "wb") : stdout;
    74	  if (!out) error("cannot open output file: %s: %s", opt_o, strerror(errno));
    75	  codegen(prog, out);
    76	  fclose(out);
    77	  return 0;
    78	}

