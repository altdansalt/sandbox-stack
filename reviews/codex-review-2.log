  2878	// funcall = (assign ("," assign)*)? ")"
  2879	static Node *funcall(Token **rest, Token *tok, Node *fn) {
  2880	  add_type(fn);
  2881	
  2882	  if (fn->ty->kind != TY_FUNC &&
  2883	      (fn->ty->kind != TY_PTR || fn->ty->base->kind != TY_FUNC))
  2884	    error_tok(fn->tok, "not a function");
  2885	
  2886	  Type *ty = (fn->ty->kind == TY_FUNC) ? fn->ty : fn->ty->base;
  2887	  Type *param_ty = ty->params;
  2888	
  2889	  Node head = {};
  2890	  Node *cur = &head;
  2891	
  2892	  while (!equal(tok, ")")) {
  2893	    if (cur != &head)
  2894	      tok = skip(tok, ",");
  2895	
  2896	    Node *arg = assign(&tok, tok);
  2897	    add_type(arg);
  2898	
  2899	    if (!param_ty && !ty->is_variadic)
  2900	      error_tok(tok, "too many arguments");
  2901	
  2902	    if (param_ty) {
  2903	      if (param_ty->kind != TY_STRUCT && param_ty->kind != TY_UNION)
  2904	        arg = new_cast(arg, param_ty);
  2905	      param_ty = param_ty->next;
  2906	    } else if (arg->ty->kind == TY_FLOAT) {
  2907	      // If parameter type is omitted (e.g. in "..."), float
  2908	      // arguments are promoted to double.
  2909	      arg = new_cast(arg, ty_double);
  2910	    }
  2911	
  2912	    cur = cur->next = arg;
  2913	  }
  2914	
  2915	  if (param_ty)
  2916	    error_tok(tok, "too few arguments");
  2917	
  2918	  *rest = skip(tok, ")");
  2919	
  2920	  Node *node = new_unary(ND_FUNCALL, fn, tok);
  2921	  node->func_ty = ty;
  2922	  node->ty = ty->return_ty;
  2923	  node->args = head.next;
  2924	
  2925	  // If a function returns a struct, it is caller's responsibility
  2926	  // to allocate a space for the return value.
  2927	  if (node->ty->kind == TY_STRUCT || node->ty->kind == TY_UNION)
  2928	    node->ret_buffer = new_lvar("", node->ty);
  2929	  return node;
  2930	}
