    34	    b->data = realloc(b->data, b->cap);
    35	  }
    36	  b->data[b->len++] = (uint8_t)v;
    37	}
    38	static void buf_bytes(Buf *b, void *p, int n) {
    39	  for (int i = 0; i < n; i++) buf_u8(b, ((uint8_t *)p)[i]);
    40	}
    41	static void buf_uleb(Buf *b, uint64_t v) {
    42	  do { int c = v & 0x7f; v >>= 7; buf_u8(b, v ? c | 0x80 : c); } while (v);
    43	}
    44	static void buf_sleb(Buf *b, int64_t v) {
    45	  for (;;) {
    46	    int c = v & 0x7f; v >>= 7;
    47	    bool done = (v == 0 && !(c & 0x40)) || (v == -1 && (c & 0x40));
    48	    buf_u8(b, done ? c : c | 0x80);
    49	    if (done) return;
    50	  }
    51	}
    52	static void buf_name(Buf *b, char *s) { buf_uleb(b, strlen(s)); buf_bytes(b, s, strlen(s)); }
    53	static void buf_buf(Buf *b, Buf *src) { buf_bytes(b, src->data, src->len); }
    54	static void buf_section(Buf *out, int id, Buf *content) {
    55	  buf_u8(out, id); buf_uleb(out, content->len); buf_buf(out, content);
    56	}
    57	
    58	// ---- value classes ----
    59	enum { VC_NONE, VC_I32, VC_I64, VC_F32, VC_F64 };
    60	static const uint8_t valtype[] = { 0, 0x7f, 0x7e, 0x7d, 0x7c };
    61	
    62	static int vclass(Type *ty) {
    63	  if (!ty) return VC_NONE; // ND_NULL_EXPR / ND_MEMZERO carry no type
    64	  switch (ty->kind) {
    65	  case TY_VOID: return VC_NONE;
    66	  case TY_FLOAT: return VC_F32;
    67	  case TY_DOUBLE: case TY_LDOUBLE: return VC_F64;
    68	  case TY_STRUCT: case TY_UNION: case TY_ARRAY: case TY_FUNC: case TY_PTR: case TY_VLA: return VC_I32;
    69	  default: return ty->size == 8 ? VC_I64 : VC_I32;
    70	  }
    71	}
    72	
    73	// ---- opcodes ----
    74	enum {
    75	  OP_UNREACHABLE = 0x00, OP_BLOCK = 0x02, OP_LOOP = 0x03, OP_IF = 0x04, OP_ELSE = 0x05, OP_END = 0x0b,
    76	  OP_BR = 0x0c, OP_BR_IF = 0x0d, OP_RETURN = 0x0f, OP_CALL = 0x10, OP_CALL_INDIRECT = 0x11,
    77	  OP_DROP = 0x1a, OP_SELECT = 0x1b,
    78	  OP_LOCAL_GET = 0x20, OP_LOCAL_SET = 0x21, OP_LOCAL_TEE = 0x22, OP_GLOBAL_GET = 0x23, OP_GLOBAL_SET = 0x24,
    79	  OP_I32_LOAD = 0x28, OP_I64_LOAD = 0x29, OP_F32_LOAD = 0x2a, OP_F64_LOAD = 0x2b,
    80	  OP_I32_LOAD8_S = 0x2c, OP_I32_LOAD8_U = 0x2d, OP_I32_LOAD16_S = 0x2e, OP_I32_LOAD16_U = 0x2f,
    81	  OP_I32_STORE = 0x36, OP_I64_STORE = 0x37, OP_F32_STORE = 0x38, OP_F64_STORE = 0x39,
    82	  OP_I32_STORE8 = 0x3a, OP_I32_STORE16 = 0x3b,
    83	  OP_MEMORY_SIZE = 0x3f, OP_MEMORY_GROW = 0x40,
    84	  OP_I32_CONST = 0x41, OP_I64_CONST = 0x42, OP_F32_CONST = 0x43, OP_F64_CONST = 0x44,
    85	  OP_I32_EQZ = 0x45, OP_I32_EQ = 0x46, OP_I32_NE = 0x47, OP_I32_LT_S = 0x48, OP_I32_LT_U = 0x49,
    86	  OP_I32_LE_S = 0x4c, OP_I32_LE_U = 0x4d,
    87	  OP_I64_EQZ = 0x50, OP_I64_EQ = 0x51, OP_I64_NE = 0x52, OP_I64_LT_S = 0x53, OP_I64_LT_U = 0x54,
    88	  OP_I64_LE_S = 0x57, OP_I64_LE_U = 0x58,
    89	  OP_F32_EQ = 0x5b, OP_F32_NE = 0x5c, OP_F32_LT = 0x5d, OP_F32_LE = 0x5f,
    90	  OP_F64_EQ = 0x61, OP_F64_NE = 0x62, OP_F64_LT = 0x63, OP_F64_LE = 0x65,
    91	  OP_I32_ADD = 0x6a, OP_I32_SUB = 0x6b, OP_I32_MUL = 0x6c, OP_I32_DIV_S = 0x6d, OP_I32_DIV_U = 0x6e,
    92	  OP_I32_REM_S = 0x6f, OP_I32_REM_U = 0x70, OP_I32_AND = 0x71, OP_I32_OR = 0x72, OP_I32_XOR = 0x73,
    93	  OP_I32_SHL = 0x74, OP_I32_SHR_S = 0x75, OP_I32_SHR_U = 0x76,
    94	  OP_I64_ADD = 0x7c, OP_I64_SUB = 0x7d, OP_I64_MUL = 0x7e, OP_I64_DIV_S = 0x7f, OP_I64_DIV_U = 0x80,
    95	  OP_I64_REM_S = 0x81, OP_I64_REM_U = 0x82, OP_I64_AND = 0x83, OP_I64_OR = 0x84, OP_I64_XOR = 0x85,
    96	  OP_I64_SHL = 0x86, OP_I64_SHR_S = 0x87, OP_I64_SHR_U = 0x88,
    97	  OP_F32_NEG = 0x8c, OP_F32_ADD = 0x92, OP_F32_SUB = 0x93, OP_F32_MUL = 0x94, OP_F32_DIV = 0x95,
    98	  OP_F64_NEG = 0x9a, OP_F64_ADD = 0xa0, OP_F64_SUB = 0xa1, OP_F64_MUL = 0xa2, OP_F64_DIV = 0xa3,
    99	  OP_I32_WRAP_I64 = 0xa7, OP_I32_TRUNC_F32_S = 0xa8, OP_I32_TRUNC_F32_U = 0xa9,
   100	  OP_I32_TRUNC_F64_S = 0xaa, OP_I32_TRUNC_F64_U = 0xab,
   101	  OP_I64_EXTEND_I32_S = 0xac, OP_I64_EXTEND_I32_U = 0xad,
   102	  OP_I64_TRUNC_F32_S = 0xae, OP_I64_TRUNC_F32_U = 0xaf, OP_I64_TRUNC_F64_S = 0xb0, OP_I64_TRUNC_F64_U = 0xb1,
   103	  OP_F32_CONVERT_I32_S = 0xb2, OP_F32_CONVERT_I32_U = 0xb3, OP_F32_CONVERT_I64_S = 0xb4, OP_F32_CONVERT_I64_U = 0xb5,
   104	  OP_F32_DEMOTE_F64 = 0xb6,
   105	  OP_F64_CONVERT_I32_S = 0xb7, OP_F64_CONVERT_I32_U = 0xb8, OP_F64_CONVERT_I64_S = 0xb9, OP_F64_CONVERT_I64_U = 0xba,
   106	  OP_F64_PROMOTE_F32 = 0xbb,
   107	  OP_I32_EXTEND8_S = 0xc0, OP_I32_EXTEND16_S = 0xc1,
   108	  OP_PREFIX_FC = 0xfc, // memory.copy = fc 0a 00 00, memory.fill = fc 0b 00
   109	};
   110	
   111	// ---- module state ----
   112	static Buf types;          // type section entries
   113	static int ntypes;
   114	static Buf *type_entries;  // each entry's bytes, for dedup
   115	static int type_cap;
   116	
   117	static HashMap func_index; // name -> (long)index + 1
   118	static Obj **funcs;        // by index
   119	static int nfuncs, nimports;
   120	static HashMap referenced; // function name -> referenced
   121	
   122	static int data_base = 1024;
   123	static int data_end;       // end of initialised + zero globals
   124	static int stack_top;      // initial $sp
   125	static int heap_base;
   126	
   127	static Buf code;           // current function body
   128	static Obj *current_fn;
   129	static int frame_size;
   130	static int loc_fp, loc_t32, loc_t32b, loc_t64, loc_tf32, loc_tf64, loc_rv;
   131	
   132	// control stack
   133	typedef struct { char *label; int id; } Ctl;
   134	static Ctl ctl[512];
   135	static int ctl_len;
   136	static int ctl_id_counter;
   137	#define RET_LABEL ".ret"
   138	
   139	static void gen_expr(Node *node);
   140	static void gen_stmt(Node *node);
   141	static void gen_addr(Node *node);
   142	
   143	// ---- emit helpers ----
   144	static void op(int o) { buf_u8(&code, o); }
   145	static void op_u(int o, uint64_t v) { buf_u8(&code, o); buf_uleb(&code, v); }
   146	static void i32c(int64_t v) { buf_u8(&code, OP_I32_CONST); buf_sleb(&code, (int32_t)v); }
   147	static void i64c(int64_t v) { buf_u8(&code, OP_I64_CONST); buf_sleb(&code, v); }
   148	static void f32c(float f) { buf_u8(&code, OP_F32_CONST); buf_bytes(&code, &f, 4); }
   149	static void f64c(double d) { buf_u8(&code, OP_F64_CONST); buf_bytes(&code, &d, 8); }
   150	static void memarg(int o, int align_log2) { buf_u8(&code, o); buf_uleb(&code, align_log2); buf_uleb(&code, 0); }
   151	static void memory_copy(void) { op(OP_PREFIX_FC); buf_uleb(&code, 10); buf_u8(&code, 0); buf_u8(&code, 0); }
   152	static void memory_fill(void) { op(OP_PREFIX_FC); buf_uleb(&code, 11); buf_u8(&code, 0); }
   153	
   154	static int push_ctl(char *label) {
   155	  if (ctl_len == 512) error("control nesting too deep");
   156	  ctl[ctl_len].label = label;
   157	  ctl[ctl_len].id = ctl_id_counter++;
   158	  ctl_len++;
   159	  return ctl[ctl_len - 1].id;
   160	}
   161	static void pop_ctl(void) { ctl_len--; }
   162	static int depth_of_label(char *label, Token *tok) {
   163	  for (int i = ctl_len - 1; i >= 0; i--)
   164	    if (ctl[i].label && !strcmp(ctl[i].label, label))
   165	      return ctl_len - 1 - i;
   166	  error_tok(tok, "unsupported control flow: no enclosing block for label %s "
   167	            "(only forward goto to a top-level label is supported)", label);
   168	}
   169	static int depth_of_id(int id) {
   170	  for (int i = ctl_len - 1; i >= 0; i--)
   171	    if (ctl[i].id == id)
   172	      return ctl_len - 1 - i;
   173	  unreachable();
   174	}
   175	static void block(char *label, int blocktype) { op(OP_BLOCK); buf_u8(&code, blocktype); push_ctl(label); }
   176	static int loop(void) { op(OP_LOOP); buf_u8(&code, 0x40); return push_ctl(NULL); }
   177	static void if_(int blocktype) { op(OP_IF); buf_u8(&code, blocktype); push_ctl(NULL); }
   178	static void end(void) { op(OP_END); pop_ctl(); }
   179	static void br_label(char *label, Token *tok) { op_u(OP_BR, depth_of_label(label, tok)); }
   180	static void br_if_label(char *label, Token *tok) { op_u(OP_BR_IF, depth_of_label(label, tok)); }
   181	
   182	// ---- function signatures ----
   183	static int add_type_entry(Buf *e) {
   184	  for (int i = 0; i < ntypes; i++)
   185	    if (type_entries[i].len == e->len && !memcmp(type_entries[i].data, e->data, e->len))
   186	      return i;
   187	  if (ntypes == type_cap) {
   188	    type_cap = type_cap ? type_cap * 2 : 64;
   189	    type_entries = realloc(type_entries, type_cap * sizeof(Buf));
   190	  }
   191	  type_entries[ntypes] = *e;
   192	  buf_buf(&types, e);
   193	  return ntypes++;
   194	}
   195	
   196	static bool is_struct(Type *ty) { return ty->kind == TY_STRUCT || ty->kind == TY_UNION; }
   197	
   198	static int sig_index(Type *fty) {
   199	  Buf e = {0};
   200	  buf_u8(&e, 0x60);
   201	  int n = 0;
   202	  Buf p = {0};
   203	  if (is_struct(fty->return_ty)) { buf_u8(&p, 0x7f); n++; }
   204	  for (Type *t = fty->params; t; t = t->next) { buf_u8(&p, valtype[vclass(t)]); n++; }
   205	  if (fty->is_variadic) { buf_u8(&p, 0x7f); n++; }
   206	  buf_uleb(&e, n); buf_buf(&e, &p);
   207	  int rc = is_struct(fty->return_ty) ? VC_NONE : vclass(fty->return_ty);
   208	  if (rc == VC_NONE) buf_u8(&e, 0);
   209	  else { buf_u8(&e, 1); buf_u8(&e, valtype[rc]); }
   210	  return add_type_entry(&e);
   211	}
   212	
   213	// ---- function references (to decide which undefined functions become imports) ----
   214	static void mark_refs(Node *n) {
   215	  for (; n; n = n->next) {
   216	    if (n->kind == ND_VAR && n->var->is_function)
   217	      hashmap_put(&referenced, n->var->name, (void *)1);
   218	    mark_refs(n->lhs); mark_refs(n->rhs); mark_refs(n->cond); mark_refs(n->then);
   219	    mark_refs(n->els); mark_refs(n->init); mark_refs(n->inc); mark_refs(n->body);
   220	    mark_refs(n->args);
   221	  }
   222	}
   223	
   224	static int func_idx(Obj *fn, Token *tok) {
   225	  void *v = hashmap_get(&func_index, fn->name);
   226	  if (!v) error_tok(tok, "function %s is neither defined nor an env import", fn->name);
   227	  return (int)(long)v - 1;
   228	}
   229	
   230	static HashMap global_def;  // name -> defining Obj (declarations are separate Objs in chibicc)
   231	
   232	static int global_addr(Obj *var, Token *tok) {
   233	  if (var->is_function) return func_idx(var, tok) + 1; // table index
   234	  Obj *def = hashmap_get(&global_def, var->name);
   235	  if (!def) {
   236	    if (!strcmp(var->name, "__heap_base")) return heap_base;
   237	    error_tok(tok, "undefined global %s", var->name);
   238	  }
   239	  return def->offset;
   240	}
   241	
   242	// ---- loads/stores ----
   243	static int align_log2(int n) { int r = 0; while ((1 << r) < n && r < 3) r++; return r; }
   244	
   245	static void load(Type *ty) {
   246	  switch (ty->kind) {
   247	  case TY_ARRAY: case TY_STRUCT: case TY_UNION: case TY_FUNC: case TY_VLA: return;
   248	  case TY_FLOAT: memarg(OP_F32_LOAD, 2); return;
   249	  case TY_DOUBLE: case TY_LDOUBLE: memarg(OP_F64_LOAD, 3); return;
   250	  default: break;
   251	  }
   252	  switch (ty->size) {
   253	  case 1: memarg(ty->is_unsigned || ty->kind == TY_BOOL ? OP_I32_LOAD8_U : OP_I32_LOAD8_S, 0); return;
   254	  case 2: memarg(ty->is_unsigned ? OP_I32_LOAD16_U : OP_I32_LOAD16_S, 1); return;
   255	  case 4: memarg(OP_I32_LOAD, 2); return;
   256	  case 8: memarg(OP_I64_LOAD, 3); return;
   257	  }
   258	  unreachable();
   259	}
   260	
   261	static void store(Type *ty) {
   262	  switch (ty->kind) {
   263	  case TY_FLOAT: memarg(OP_F32_STORE, 2); return;
   264	  case TY_DOUBLE: case TY_LDOUBLE: memarg(OP_F64_STORE, 3); return;
   265	  default: break;
   266	  }
   267	  switch (ty->size) {
   268	  case 1: memarg(OP_I32_STORE8, 0); return;
   269	  case 2: memarg(OP_I32_STORE16, 1); return;
   270	  case 4: memarg(OP_I32_STORE, 2); return;
   271	  case 8: memarg(OP_I64_STORE, 3); return;
   272	  }
   273	  unreachable();
   274	}
   275	
   276	// ---- casts ----
   277	static void to_bool(int vc) {
   278	  switch (vc) {
   279	  case VC_I32: i32c(0); op(OP_I32_NE); return;
   280	  case VC_I64: i64c(0); op(OP_I64_NE); return;
   281	  case VC_F32: f32c(0); op(OP_F32_NE); return;
   282	  case VC_F64: f64c(0); op(OP_F64_NE); return;
   283	  }
   284	}
   285	
   286	// value of class `from` on the stack -> class `to`
   287	static void convert(int from, int to, bool from_unsigned) {
   288	  if (from == to) return;
   289	  switch (from) {
   290	  case VC_I32:
   291	    switch (to) {
   292	    case VC_I64: op(from_unsigned ? OP_I64_EXTEND_I32_U : OP_I64_EXTEND_I32_S); return;
   293	    case VC_F32: op(from_unsigned ? OP_F32_CONVERT_I32_U : OP_F32_CONVERT_I32_S); return;
   294	    case VC_F64: op(from_unsigned ? OP_F64_CONVERT_I32_U : OP_F64_CONVERT_I32_S); return;
   295	    }
   296	    break;
   297	  case VC_I64:
   298	    switch (to) {
   299	    case VC_I32: op(OP_I32_WRAP_I64); return;
   300	    case VC_F32: op(from_unsigned ? OP_F32_CONVERT_I64_U : OP_F32_CONVERT_I64_S); return;
   301	    case VC_F64: op(from_unsigned ? OP_F64_CONVERT_I64_U : OP_F64_CONVERT_I64_S); return;
   302	    }
   303	    break;
   304	  case VC_F32:
   305	    switch (to) {
   306	    case VC_F64: op(OP_F64_PROMOTE_F32); return;
   307	    case VC_I32: op(from_unsigned ? OP_I32_TRUNC_F32_U : OP_I32_TRUNC_F32_S); return;
   308	    case VC_I64: op(from_unsigned ? OP_I64_TRUNC_F32_U : OP_I64_TRUNC_F32_S); return;
   309	    }
   310	    break;
   311	  case VC_F64:
   312	    switch (to) {
   313	    case VC_F32: op(OP_F32_DEMOTE_F64); return;
   314	    case VC_I32: op(from_unsigned ? OP_I32_TRUNC_F64_U : OP_I32_TRUNC_F64_S); return;
   315	    case VC_I64: op(from_unsigned ? OP_I64_TRUNC_F64_U : OP_I64_TRUNC_F64_S); return;
   316	    }
   317	    break;
   318	  }
   319	  unreachable();
   320	}
   321	
   322	// narrow an i32 to the representation of a small integer type
   323	static void narrow(Type *to) {
   324	  if (to->kind == TY_BOOL) return; // handled by caller
   325	  switch (to->size) {
   326	  case 1: if (to->is_unsigned) { i32c(0xff); op(OP_I32_AND); } else op(OP_I32_EXTEND8_S); return;
   327	  case 2: if (to->is_unsigned) { i32c(0xffff); op(OP_I32_AND); } else op(OP_I32_EXTEND16_S); return;
   328	  }
   329	}
   330	
   331	static void cast(Type *from, Type *to) {
   332	  int fc = vclass(from), tc = vclass(to);
   333	  if (to->kind == TY_VOID) { if (fc != VC_NONE) op(OP_DROP); return; }
   334	  if (to->kind == TY_BOOL) { to_bool(fc); return; }
   335	  // when converting a float to a small integer, go through i32 with the target's signedness
   336	  bool from_unsigned = from->is_unsigned || from->kind == TY_PTR || from->kind == TY_ARRAY;
   337	  if ((fc == VC_F32 || fc == VC_F64) && (tc == VC_I32 || tc == VC_I64))
   338	    from_unsigned = to->is_unsigned;
   339	  convert(fc, tc, from_unsigned);
   340	  if (tc == VC_I32 && is_integer(to) && to->size < 4)
   341	    if (from->size > to->size || fc != VC_I32 || from->is_unsigned != to->is_unsigned)
   342	      narrow(to);
   343	}
   344	
   345	// generate expression and convert its value to class vc
   346	static void gen_expr_as(Node *node, int vc) {
   347	  gen_expr(node);
   348	  convert(vclass(node->ty), vc, node->ty->is_unsigned || node->ty->kind == TY_PTR);
   349	}
   350	
   351	// evaluate to an i32 that is 0 or 1
   352	static void gen_cond(Node *node) {
   353	  gen_expr(node);
   354	  to_bool(vclass(node->ty));
   355	}
   356	
   357	// ---- addresses ----
   358	static void fp_plus(int off) {
   359	  op_u(OP_LOCAL_GET, loc_fp);
   360	  if (off) { i32c(off); op(OP_I32_ADD); }
   361	}
   362	
   363	static void gen_addr(Node *node) {
   364	  switch (node->kind) {
   365	  case ND_VAR:
   366	    if (node->var->ty->kind == TY_VLA) error_tok(node->tok, "VLA is not supported");
   367	    if (node->var->is_local) { fp_plus(node->var->offset); return; }
   368	    if (node->var->is_tls) error_tok(node->tok, "TLS is not supported");
   369	    i32c(global_addr(node->var, node->tok));
   370	    return;
   371	  case ND_DEREF:
   372	    gen_expr_as(node->lhs, VC_I32);
   373	    return;
   374	  case ND_COMMA:
   375	    gen_expr(node->lhs);
   376	    if (vclass(node->lhs->ty) != VC_NONE) op(OP_DROP);
   377	    gen_addr(node->rhs);
   378	    return;
   379	  case ND_MEMBER:
   380	    gen_addr(node->lhs);
   381	    if (node->member->offset) { i32c(node->member->offset); op(OP_I32_ADD); }
   382	    return;
   383	  case ND_FUNCALL:
   384	    if (node->ret_buffer) { gen_expr(node); return; }
   385	    break;
   386	  case ND_ASSIGN:
   387	  case ND_COND:
   388	    if (is_struct(node->ty)) { gen_expr(node); return; }
   389	    break;
   390	  default:
   391	    break;
   392	  }
   393	  error_tok(node->tok, "not an lvalue");
   394	}
   395	
   396	// ---- calls ----
   397	static int count_params(Type *fty) { int n = 0; for (Type *t = fty->params; t; t = t->next) n++; return n; }
   398	
   399	static void gen_funcall(Node *node) {
   400	  Type *fty = node->func_ty;
   401	  Obj *callee = (node->lhs->kind == ND_VAR && node->lhs->var->is_function) ? node->lhs->var : NULL;
   402	
   403	  if (callee) {
   404	    if (!strcmp(callee->name, "__builtin_wasm_memory_size")) {
   405	      for (Node *a = node->args; a; a = a->next) { gen_expr(a); op(OP_DROP); }
   406	      op(OP_MEMORY_SIZE); buf_u8(&code, 0);
   407	      convert(VC_I32, vclass(node->ty), true);
   408	      return;
   409	    }
   410	    if (!strcmp(callee->name, "__builtin_wasm_memory_grow")) {
   411	      gen_expr(node->args); op(OP_DROP);
   412	      gen_expr_as(node->args->next, VC_I32);
   413	      op(OP_MEMORY_GROW); buf_u8(&code, 0);
   414	      convert(VC_I32, vclass(node->ty), true);
   415	      return;
   416	    }
   417	    if (!strcmp(callee->name, "alloca")) error_tok(node->tok, "alloca is not supported");
   418	  }
   419	
   420	  if (node->ret_buffer) fp_plus(node->ret_buffer->offset);
   421	
   422	  int nfixed = count_params(fty);
   423	  Node *arg = node->args;
   424	  for (int i = 0; i < nfixed; i++, arg = arg->next) gen_expr(arg);
   425	
   426	  if (fty->is_variadic) {
   427	    int nva = 0;
   428	    for (Node *a = arg; a; a = a->next) nva++;
   429	    int size = align_to(nva * 8, 16);
   430	    if (size) {
   431	      op_u(OP_GLOBAL_GET, 0); i32c(size); op(OP_I32_SUB); op_u(OP_GLOBAL_SET, 0);
   432	    }
   433	    int slot = 0;
   434	    for (Node *a = arg; a; a = a->next, slot++) {
   435	      if (is_struct(a->ty)) error_tok(a->tok, "passing a struct as a variadic argument is not supported");
   436	      op_u(OP_GLOBAL_GET, 0);
   437	      if (slot) { i32c(slot * 8); op(OP_I32_ADD); }
   438	      gen_expr(a);
   439	      switch (vclass(a->ty)) {
   440	      case VC_I32: memarg(OP_I32_STORE, 2); break;
   441	      case VC_I64: memarg(OP_I64_STORE, 3); break;
   442	      case VC_F32: memarg(OP_F32_STORE, 2); break;
   443	      case VC_F64: memarg(OP_F64_STORE, 3); break;
   444	      default: unreachable();
   445	      }
   446	    }
   447	    op_u(OP_GLOBAL_GET, 0); // the va pointer argument
   448	    if (callee) op_u(OP_CALL, func_idx(callee, node->tok));
   449	    else { gen_expr_as(node->lhs, VC_I32); op(OP_CALL_INDIRECT); buf_uleb(&code, sig_index(fty)); buf_u8(&code, 0); }
   450	    if (size) {
   451	      op_u(OP_GLOBAL_GET, 0); i32c(size); op(OP_I32_ADD); op_u(OP_GLOBAL_SET, 0);
   452	    }
   453	  } else {
   454	    if (arg) error_tok(node->tok, "too many arguments");
   455	    if (callee) op_u(OP_CALL, func_idx(callee, node->tok));
   456	    else { gen_expr_as(node->lhs, VC_I32); op(OP_CALL_INDIRECT); buf_uleb(&code, sig_index(fty)); buf_u8(&code, 0); }
   457	  }
   458	
   459	  if (node->ret_buffer) fp_plus(node->ret_buffer->offset);
   460	}
   461	
   462	// ---- expressions ----
   463	static int scratch_local(int vc) {
   464	  switch (vc) {
   465	  case VC_I32: return loc_t32;
   466	  case VC_I64: return loc_t64;
   467	  case VC_F32: return loc_tf32;
   468	  case VC_F64: return loc_tf64;
   469	  }
   470	  unreachable();
   471	}
   472	
   473	static void gen_binary(Node *node) {
   474	  bool fl = is_flonum(node->lhs->ty);
   475	  int vc = vclass(node->lhs->ty);
   476	  bool u = node->lhs->ty->is_unsigned || node->lhs->ty->kind == TY_PTR || node->lhs->ty->kind == TY_ARRAY;
   477	  bool cmp = node->kind == ND_EQ || node->kind == ND_NE || node->kind == ND_LT || node->kind == ND_LE;
   478	  if (!cmp) vc = vclass(node->ty);
   479	
   480	  gen_expr_as(node->lhs, vc);
   481	  gen_expr_as(node->rhs, vc);
   482	
   483	  if (fl) {
   484	    bool d = vc == VC_F64;
   485	    switch (node->kind) {
   486	    case ND_ADD: op(d ? OP_F64_ADD : OP_F32_ADD); return;
   487	    case ND_SUB: op(d ? OP_F64_SUB : OP_F32_SUB); return;
   488	    case ND_MUL: op(d ? OP_F64_MUL : OP_F32_MUL); return;
   489	    case ND_DIV: op(d ? OP_F64_DIV : OP_F32_DIV); return;
   490	    case ND_EQ: op(d ? OP_F64_EQ : OP_F32_EQ); return;
   491	    case ND_NE: op(d ? OP_F64_NE : OP_F32_NE); return;
   492	    case ND_LT: op(d ? OP_F64_LT : OP_F32_LT); return;
   493	    case ND_LE: op(d ? OP_F64_LE : OP_F32_LE); return;
   494	    default: error_tok(node->tok, "invalid float operation");
   495	    }
   496	  }
   497	  bool w = vc == VC_I64;
   498	  switch (node->kind) {
   499	  case ND_ADD: op(w ? OP_I64_ADD : OP_I32_ADD); return;
   500	  case ND_SUB: op(w ? OP_I64_SUB : OP_I32_SUB); return;
   501	  case ND_MUL: op(w ? OP_I64_MUL : OP_I32_MUL); return;
   502	  case ND_DIV: op(w ? (u ? OP_I64_DIV_U : OP_I64_DIV_S) : (u ? OP_I32_DIV_U : OP_I32_DIV_S)); return;
   503	  case ND_MOD: op(w ? (u ? OP_I64_REM_U : OP_I64_REM_S) : (u ? OP_I32_REM_U : OP_I32_REM_S)); return;
   504	  case ND_BITAND: op(w ? OP_I64_AND : OP_I32_AND); return;
   505	  case ND_BITOR: op(w ? OP_I64_OR : OP_I32_OR); return;
   506	  case ND_BITXOR: op(w ? OP_I64_XOR : OP_I32_XOR); return;
   507	  case ND_SHL: op(w ? OP_I64_SHL : OP_I32_SHL); return;
   508	  case ND_SHR: op(w ? (u ? OP_I64_SHR_U : OP_I64_SHR_S) : (u ? OP_I32_SHR_U : OP_I32_SHR_S)); return;
   509	  case ND_EQ: op(w ? OP_I64_EQ : OP_I32_EQ); return;
   510	  case ND_NE: op(w ? OP_I64_NE : OP_I32_NE); return;
   511	  case ND_LT: op(w ? (u ? OP_I64_LT_U : OP_I64_LT_S) : (u ? OP_I32_LT_U : OP_I32_LT_S)); return;
   512	  case ND_LE: op(w ? (u ? OP_I64_LE_U : OP_I64_LE_S) : (u ? OP_I32_LE_U : OP_I32_LE_S)); return;
   513	  default: unreachable();
   514	  }
   515	}
   516	
   517	static void gen_expr(Node *node) {
   518	  switch (node->kind) {
   519	  case ND_NULL_EXPR:
   520	    return;
   521	  case ND_NUM:
   522	    switch (vclass(node->ty)) {
   523	    case VC_F32: f32c((float)node->fval); return;
   524	    case VC_F64: f64c((double)node->fval); return;
   525	    case VC_I64: i64c(node->val); return;
   526	    default: i32c(node->val); return;
   527	    }
   528	  case ND_NEG:
   529	    switch (vclass(node->ty)) {
   530	    case VC_F32: gen_expr(node->lhs); op(OP_F32_NEG); return;
   531	    case VC_F64: gen_expr(node->lhs); op(OP_F64_NEG); return;
   532	    case VC_I64: i64c(0); gen_expr_as(node->lhs, VC_I64); op(OP_I64_SUB); return;
   533	    default: i32c(0); gen_expr_as(node->lhs, VC_I32); op(OP_I32_SUB); return;
   534	    }
   535	  case ND_VAR:
   536	    gen_addr(node);
   537	    load(node->ty);
   538	    return;
   539	  case ND_MEMBER:
   540	    if (node->member->is_bitfield) error_tok(node->tok, "bitfields are not supported");
   541	    gen_addr(node);
   542	    load(node->ty);
   543	    return;
   544	  case ND_DEREF:
   545	    gen_addr(node);
   546	    load(node->ty);
   547	    return;
   548	  case ND_ADDR:
   549	    gen_addr(node->lhs);
   550	    return;
   551	  case ND_ASSIGN: {
   552	    if (node->lhs->kind == ND_MEMBER && node->lhs->member->is_bitfield)
   553	      error_tok(node->tok, "bitfields are not supported");
   554	    if (is_struct(node->ty)) {
   555	      gen_addr(node->lhs);
   556	      op_u(OP_LOCAL_TEE, loc_t32b);
   557	      gen_expr(node->rhs);
   558	      i32c(node->ty->size);
   559	      memory_copy();
   560	      op_u(OP_LOCAL_GET, loc_t32b);
   561	      return;
   562	    }
   563	    int vc = vclass(node->ty);
   564	    gen_addr(node->lhs);
   565	    gen_expr_as(node->rhs, vc);
   566	    op_u(OP_LOCAL_TEE, scratch_local(vc));
   567	    store(node->ty);
   568	    op_u(OP_LOCAL_GET, scratch_local(vc));
   569	    return;
   570	  }
   571	  case ND_STMT_EXPR:
   572	    error_tok(node->tok, "statement expressions are not supported");
   573	  case ND_COMMA:
   574	    gen_expr(node->lhs);
   575	    if (vclass(node->lhs->ty) != VC_NONE) op(OP_DROP);
   576	    gen_expr(node->rhs);
   577	    return;
   578	  case ND_CAST:
   579	    gen_expr(node->lhs);
   580	    cast(node->lhs->ty, node->ty);
   581	    return;
   582	  case ND_MEMZERO:
   583	    fp_plus(node->var->offset);
   584	    i32c(0);
   585	    i32c(node->var->ty->size);
   586	    memory_fill();
   587	    return;
   588	  case ND_COND: {
   589	    int vc = vclass(node->ty);
   590	    gen_cond(node->cond);
   591	    if_(vc == VC_NONE ? 0x40 : valtype[vc]);
   592	    gen_expr_as(node->then, vc);
   593	    op(OP_ELSE);
   594	    gen_expr_as(node->els, vc);
   595	    end();
   596	    return;
   597	  }
   598	  case ND_NOT:
   599	    gen_cond(node->lhs);
   600	    op(OP_I32_EQZ);
   601	    return;
   602	  case ND_BITNOT:
   603	    if (vclass(node->ty) == VC_I64) { gen_expr_as(node->lhs, VC_I64); i64c(-1); op(OP_I64_XOR); }
   604	    else { gen_expr_as(node->lhs, VC_I32); i32c(-1); op(OP_I32_XOR); }
   605	    return;
   606	  case ND_LOGAND:
   607	    gen_cond(node->lhs);
   608	    if_(0x7f);
   609	    gen_cond(node->rhs);
   610	    op(OP_ELSE);
   611	    i32c(0);
   612	    end();
   613	    return;
   614	  case ND_LOGOR:
   615	    gen_cond(node->lhs);
   616	    if_(0x7f);
   617	    i32c(1);
   618	    op(OP_ELSE);
   619	    gen_cond(node->rhs);
   620	    end();
   621	    return;
   622	  case ND_FUNCALL:
   623	    gen_funcall(node);
   624	    return;
   625	  case ND_ADD: case ND_SUB: case ND_MUL: case ND_DIV: case ND_MOD:
   626	  case ND_BITAND: case ND_BITOR: case ND_BITXOR: case ND_SHL: case ND_SHR:
   627	  case ND_EQ: case ND_NE: case ND_LT: case ND_LE:
   628	    gen_binary(node);
   629	    return;
   630	  case ND_LABEL_VAL: case ND_CAS: case ND_EXCH: case ND_VLA_PTR:
   631	    error_tok(node->tok, "unsupported expression");
   632	  default:
   633	    error_tok(node->tok, "invalid expression");
   634	  }
   635	}
   636	
   637	// ---- statements ----
   638	static void collect_cases(Node *n, Node **out, int *count, int max, Token *tok) {
   639	  // cases at the top level of the switch body, in source order; a case's
   640	  // lhs may itself be a case (case 1: case 2: stmt)
   641	  for (; n; n = n->next)
   642	    for (Node *c = n; c->kind == ND_CASE; c = c->lhs) {
   643	      if (*count == max) error_tok(tok, "too many cases");
   644	      out[(*count)++] = c;
   645	    }
   646	}
   647	
   648	static void gen_switch(Node *node) {
   649	  int vc = vclass(node->cond->ty);
   650	  gen_expr(node->cond);
   651	  op_u(OP_LOCAL_SET, scratch_local(vc));
   652	
   653	  Node *cases[1024];
   654	  int ncases = 0;
   655	  Node *body = node->then;
   656	  if (body->kind == ND_BLOCK) collect_cases(body->body, cases, &ncases, 1024, node->tok);
   657	  else collect_cases(body, cases, &ncases, 1024, node->tok);
   658	
   659	  block(node->brk_label, 0x40);
   660	  for (int i = ncases - 1; i >= 0; i--) block(cases[i]->label, 0x40);
   661	
   662	  for (Node *c = node->case_next; c; c = c->case_next) {
   663	    op_u(OP_LOCAL_GET, scratch_local(vc));
   664	    if (c->begin == c->end) {
   665	      if (vc == VC_I64) { i64c(c->begin); op(OP_I64_EQ); } else { i32c(c->begin); op(OP_I32_EQ); }
   666	    } else {
   667	      if (vc == VC_I64) { i64c(c->begin); op(OP_I64_SUB); i64c(c->end - c->begin); op(OP_I64_LE_U); }
   668	      else { i32c(c->begin); op(OP_I32_SUB); i32c(c->end - c->begin); op(OP_I32_LE_U); }
   669	    }
   670	    br_if_label(c->label, c->tok);
   671	  }
   672	  br_label(node->default_case ? node->default_case->label : node->brk_label, node->tok);
   673	
   674	  gen_stmt(node->then);
   675	  // every case block must have been closed by its ND_CASE
   676	  if (ctl_len == 0 || !ctl[ctl_len - 1].label || strcmp(ctl[ctl_len - 1].label, node->brk_label))
   677	    error_tok(node->tok, "unsupported switch shape (a case is nested inside another statement)");
   678	  end();
   679	}
   680	
   681	static void gen_stmt(Node *node) {
   682	  switch (node->kind) {
   683	  case ND_BLOCK:
   684	    for (Node *n = node->body; n; n = n->next) gen_stmt(n);
   685	    return;
   686	  case ND_EXPR_STMT:
   687	    gen_expr(node->lhs);
   688	    if (vclass(node->lhs->ty) != VC_NONE) op(OP_DROP);
   689	    return;
   690	  case ND_IF:
   691	    gen_cond(node->cond);
   692	    if_(0x40);
   693	    gen_stmt(node->then);
   694	    if (node->els) { op(OP_ELSE); gen_stmt(node->els); }
   695	    end();
   696	    return;
   697	  case ND_FOR: {
   698	    if (node->init) gen_stmt(node->init);
   699	    block(node->brk_label, 0x40);
   700	    int top = loop();
   701	    if (node->cond) { gen_cond(node->cond); op(OP_I32_EQZ); br_if_label(node->brk_label, node->tok); }
   702	    block(node->cont_label, 0x40);
   703	    gen_stmt(node->then);
   704	    end();
   705	    if (node->inc) { gen_expr(node->inc); if (vclass(node->inc->ty) != VC_NONE) op(OP_DROP); }
   706	    op_u(OP_BR, depth_of_id(top));
   707	    end();
   708	    end();
   709	    return;
   710	  }
   711	  case ND_DO: {
   712	    block(node->brk_label, 0x40);
   713	    int top = loop();
   714	    block(node->cont_label, 0x40);
   715	    gen_stmt(node->then);
   716	    end();
   717	    gen_cond(node->cond);
   718	    op_u(OP_BR_IF, depth_of_id(top));
   719	    end();
   720	    end();
   721	    return;
   722	  }
   723	  case ND_SWITCH:
   724	    gen_switch(node);
   725	    return;
   726	  case ND_CASE:
   727	    if (ctl_len == 0 || !ctl[ctl_len - 1].label || strcmp(ctl[ctl_len - 1].label, node->label))
   728	      error_tok(node->tok, "unsupported switch shape (case nested inside another statement)");
   729	    end();
   730	    gen_stmt(node->lhs);
   731	    return;
   732	  case ND_GOTO:
   733	    br_label(node->unique_label, node->tok);
   734	    return;
   735	  case ND_LABEL:
   736	    if (ctl_len == 0 || !ctl[ctl_len - 1].label || strcmp(ctl[ctl_len - 1].label, node->unique_label))
   737	      error_tok(node->tok, "unsupported label position (labels must be at the top level of the function body)");
   738	    end();
   739	    gen_stmt(node->lhs);
   740	    return;
   741	  case ND_RETURN:
   742	    if (node->lhs) {
   743	      Type *ty = node->lhs->ty;
   744	      if (is_struct(ty)) {
   745	        op_u(OP_LOCAL_GET, 0); // hidden return pointer
   746	        gen_expr(node->lhs);
   747	        i32c(ty->size);
   748	        memory_copy();
   749	      } else {
   750	        gen_expr_as(node->lhs, vclass(current_fn->ty->return_ty));
   751	        op_u(OP_LOCAL_SET, loc_rv);
   752	      }
   753	    }
   754	    br_label(RET_LABEL, node->tok);
   755	    return;
   756	  case ND_GOTO_EXPR: case ND_ASM:
   757	    error_tok(node->tok, "unsupported statement");
   758	  default:
   759	    error_tok(node->tok, "invalid statement");
   760	  }
   761	}
   762	
   763	// ---- functions ----
   764	static void assign_lvar_offsets(Obj *fn) {
   765	  int off = 0;
   766	  for (Obj *var = fn->locals; var; var = var->next) {
   767	    if (var->ty->kind == TY_VLA) error_tok(var->tok, "VLA is not supported");
   768	    int align = var->align < 1 ? 1 : var->align;
   769	    off = align_to(off, align);
   770	    var->offset = off;
   771	    off += var->ty->size;
   772	  }
   773	  frame_size = align_to(off, 16);
   774	}
   775	
   776	static void gen_function(Obj *fn, Buf *out) {
   777	  current_fn = fn;
   778	  code.len = 0;
   779	  ctl_len = 0;
   780	  assign_lvar_offsets(fn);
   781	
   782	  int nparams = 0;
   783	  for (Obj *p = fn->params; p; p = p->next) nparams++;
   784	  if (fn->ty->is_variadic) nparams++;
   785	  loc_fp = nparams; loc_t32 = nparams + 1; loc_t32b = nparams + 2;
   786	  loc_t64 = nparams + 3; loc_tf32 = nparams + 4; loc_tf64 = nparams + 5; loc_rv = nparams + 6;
   787	  int rc = is_struct(fn->ty->return_ty) ? VC_NONE : vclass(fn->ty->return_ty);
   788	
   789	  // prologue: fp = sp - frame; sp = fp
   790	  op_u(OP_GLOBAL_GET, 0);
   791	  if (frame_size) { i32c(frame_size); op(OP_I32_SUB); }
   792	  op_u(OP_LOCAL_TEE, loc_fp);
   793	  op_u(OP_GLOBAL_SET, 0);
   794	
   795	  // spill parameters into their frame slots
   796	  int i = 0;
   797	  for (Obj *p = fn->params; p; p = p->next, i++) {
   798	    if (is_struct(p->ty)) {
   799	      fp_plus(p->offset); op_u(OP_LOCAL_GET, i); i32c(p->ty->size); memory_copy();
   800	    } else {
   801	      fp_plus(p->offset); op_u(OP_LOCAL_GET, i); store(p->ty);
   802	    }
   803	  }
   804	  if (fn->ty->is_variadic) {
   805	    fp_plus(fn->va_area->offset); op_u(OP_LOCAL_GET, i); memarg(OP_I32_STORE, 2);
   806	  }
   807	
   808	  // blocks for forward gotos to top-level labels
   809	  Node *body = fn->body;
   810	  Node *labels[256];
   811	  int nlabels = 0;
   812	  if (body->kind == ND_BLOCK)
   813	    for (Node *n = body->body; n; n = n->next)
   814	      if (n->kind == ND_LABEL) {
   815	        if (nlabels == 256) error_tok(n->tok, "too many labels");
   816	        labels[nlabels++] = n;
   817	      }
   818	  block(RET_LABEL, 0x40);
   819	  for (int k = nlabels - 1; k >= 0; k--) block(labels[k]->unique_label, 0x40);
   820	
   821	  gen_stmt(body);
   822	
   823	  // unclosed label blocks (label never reached at top level) would be a bug
   824	  if (ctl_len != 1) error_tok(fn->tok, "internal error: unbalanced control stack in %s", fn->name);
   825	  end();
   826	
   827	  // epilogue: sp = fp + frame
   828	  op_u(OP_LOCAL_GET, loc_fp);
   829	  if (frame_size) { i32c(frame_size); op(OP_I32_ADD); }
   830	  op_u(OP_GLOBAL_SET, 0);
   831	  if (rc != VC_NONE) op_u(OP_LOCAL_GET, loc_rv);
   832	  op(OP_END);
   833	
   834	  // function body: locals declaration + code
   835	  Buf body_buf = {0};
   836	  buf_uleb(&body_buf, rc == VC_NONE ? 4 : 5);
   837	  buf_uleb(&body_buf, 3); buf_u8(&body_buf, 0x7f);
   838	  buf_uleb(&body_buf, 1); buf_u8(&body_buf, 0x7e);
   839	  buf_uleb(&body_buf, 1); buf_u8(&body_buf, 0x7d);
   840	  buf_uleb(&body_buf, 1); buf_u8(&body_buf, 0x7c);
   841	  if (rc != VC_NONE) { buf_uleb(&body_buf, 1); buf_u8(&body_buf, valtype[rc]); }
   842	  buf_buf(&body_buf, &code);
   843	  buf_uleb(out, body_buf.len);
   844	  buf_buf(out, &body_buf);
   845	  free(body_buf.data);
   846	}
   847	
   848	// ---- data ----
   849	static void layout_globals(Obj *prog) {
   850	  int addr = data_base;
   851	  // initialised globals first, then zero-initialised ones, so one data segment covers the former;
   852	  // one storage location per name (a tentative definition repeated in several headers is one object)
   853	  for (int pass = 0; pass < 2; pass++) {
   854	    for (Obj *var = prog; var; var = var->next) {
