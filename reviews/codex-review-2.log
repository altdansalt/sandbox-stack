   586	// func-params = ("void" | param ("," param)* ("," "...")?)? ")"
   587	// param       = declspec declarator
   588	static Type *func_params(Token **rest, Token *tok, Type *ty) {
   589	  if (equal(tok, "void") && equal(tok->next, ")")) {
   590	    *rest = tok->next->next;
   591	    return func_type(ty);
   592	  }
   593	
   594	  Type head = {};
   595	  Type *cur = &head;
   596	  bool is_variadic = false;
   597	
   598	  while (!equal(tok, ")")) {
   599	    if (cur != &head)
   600	      tok = skip(tok, ",");
   601	
   602	    if (equal(tok, "...")) {
   603	      is_variadic = true;
   604	      tok = tok->next;
   605	      skip(tok, ")");
   606	      break;
   607	    }
   608	
   609	    Type *ty2 = declspec(&tok, tok, NULL);
   610	    ty2 = declarator(&tok, tok, ty2);
   611	
   612	    Token *name = ty2->name;
   613	
   614	    if (ty2->kind == TY_ARRAY) {
   615	      // "array of T" is converted to "pointer to T" only in the parameter
   616	      // context. For example, *argv[] is converted to **argv by this.
   617	      ty2 = pointer_to(ty2->base);
   618	      ty2->name = name;
   619	    } else if (ty2->kind == TY_FUNC) {
   620	      // Likewise, a function is converted to a pointer to a function
   621	      // only in the parameter context.
   622	      ty2 = pointer_to(ty2);
   623	      ty2->name = name;
   624	    }
   625	
   626	    cur = cur->next = copy_type(ty2);
   627	  }
   628	
   629	  if (cur == &head)
   630	    is_variadic = true;
   631	
   632	  ty = func_type(ty);
   633	  ty->params = head.next;
   634	  ty->is_variadic = is_variadic;
   635	  *rest = tok->next;
   636	  return ty;
   637	}
