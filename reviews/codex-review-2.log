   639	// array-dimensions = ("static" | "restrict")* const-expr? "]" type-suffix
   640	static Type *array_dimensions(Token **rest, Token *tok, Type *ty) {
   641	  while (equal(tok, "static") || equal(tok, "restrict"))
   642	    tok = tok->next;
   643	
   644	  if (equal(tok, "]")) {
   645	    ty = type_suffix(rest, tok->next, ty);
