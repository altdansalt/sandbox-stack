   342	static bool convert_pp_int(Token *tok) {
   343	  char *p = tok->loc;
   344	
   345	  // Read a binary, octal, decimal or hexadecimal number.
   346	  int base = 10;
   347	  if (!strncasecmp(p, "0x", 2) && isxdigit(p[2])) {
   348	    p += 2;
   349	    base = 16;
   350	  } else if (!strncasecmp(p, "0b", 2) && (p[2] == '0' || p[2] == '1')) {
   351	    p += 2;
   352	    base = 2;
   353	  } else if (*p == '0') {
   354	    base = 8;
   355	  }
   356	
   357	  int64_t val = strtoul(p, &p, base);
   358	
   359	  // Read U, L or LL suffixes.
   360	  bool l = false;
   361	  bool u = false;
   362	  bool ll = false;
   363	
   364	  if (startswith(p, "LLU") || startswith(p, "LLu") ||
   365	      startswith(p, "llU") || startswith(p, "llu") ||
   366	      startswith(p, "ULL") || startswith(p, "Ull") ||
   367	      startswith(p, "uLL") || startswith(p, "ull")) {
   368	    p += 3;
   369	    l = u = ll = true;
   370	  } else if (!strncasecmp(p, "lu", 2) || !strncasecmp(p, "ul", 2)) {
   371	    p += 2;
   372	    l = u = true;
   373	  } else if (startswith(p, "LL") || startswith(p, "ll")) {
   374	    p += 2;
   375	    l = ll = true;
   376	  } else if (*p == 'L' || *p == 'l') {
   377	    p++;
   378	    l = true;
   379	  } else if (*p == 'U' || *p == 'u') {
   380	    p++;
   381	    u = true;
   382	  }
   383	
   384	  if (p != tok->loc + tok->len)
   385	    return false;
   386	
   387	  // Infer a type (ILP32: int and long are 4 bytes, long long is 8).
   388	  Type *ty;
   389	  if (ll) {
   390	    ty = u ? ty_ullong : (base != 10 && (val >> 63)) ? ty_ullong : ty_llong;
   391	  } else if (base == 10) {
   392	    if (l && u)
   393	      ty = (val >> 32) ? ty_ullong : ty_ulong;
   394	    else if (l)
   395	      ty = (val >> 31) ? ty_llong : ty_long;
   396	    else if (u)
   397	      ty = (val >> 32) ? ty_ullong : ty_uint;
   398	    else
   399	      ty = (val >> 31) ? ty_llong : ty_int;
   400	  } else {
   401	    if (l && u)
   402	      ty = (val >> 32) ? ty_ullong : ty_ulong;
   403	    else if (l)
   404	      ty = (val >> 63) ? ty_ullong : (val >> 32) ? ty_llong : (val >> 31) ? ty_ulong : ty_long;
   405	    else if (u)
   406	      ty = (val >> 32) ? ty_ullong : ty_uint;
   407	    else if (val >> 63)
   408	      ty = ty_ullong;
   409	    else if (val >> 32)
   410	      ty = ty_llong;
   411	    else if (val >> 31)
   412	      ty = ty_uint;
   413	    else
   414	      ty = ty_int;
   415	  }
   416	
   417	  tok->kind = TK_NUM;
   418	  tok->val = val;
   419	  tok->ty = ty;
   420	  return true;
   421	}
