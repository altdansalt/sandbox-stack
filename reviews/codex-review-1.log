   154	        v = v * (unsigned long)base + (unsigned long)d;
   155	    }
   156	    if (end) *end = (char*)s;
   157	    return v;
   158	}
   159	/* deterministic, stable insertion sort: same result on every platform (glibc's qsort is not stable) */
   160	void qsort(void* base, size_t n, size_t size, int (*cmp)(const void*, const void*)) {
   161	    char* b = base; char tmp[64]; size_t i, j;
   162	    if (size > sizeof tmp) abort();
   163	    for (i = 1; i < n; i++) {
   164	        memcpy(tmp, b + i * size, size);
   165	        for (j = i; j > 0 && cmp(b + (j - 1) * size, tmp) > 0; j--) memcpy(b + j * size, b + (j - 1) * size, size);
   166	        memcpy(b + j * size, tmp, size);
   167	    }
   168	}
