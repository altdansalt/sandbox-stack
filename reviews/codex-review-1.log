    78	/* integer-only printf core: flags '0' '-', width, precision (strings), l/ll/z, d i u x X c s % */
    79	typedef struct { FILE* f; char* s; } Sink;
    80	static void put(Sink* k, const char* p, size_t n) {
    81	    if (k->f) fwrite(p, 1, n, k->f); else { memcpy(k->s, p, n); k->s += n; }
    82	}
    83	static int format(Sink* k, const char* fmt, va_list ap) {
    84	    int count = 0;
    85	    while (*fmt) {
    86	        const char* start = fmt;
    87	        char num[24]; int zero = 0, left = 0, width = 0, prec = -1, longs = 0, neg = 0, len;
    88	        const char *digits, *body; unsigned long long v;
    89	        if (*fmt != '%') { while (*fmt && *fmt != '%') fmt++; put(k, start, (size_t)(fmt - start)); count += (int)(fmt - start); continue; }
    90	        fmt++;
    91	        for (;; fmt++) { if (*fmt == '0') zero = 1; else if (*fmt == '-') left = 1; else break; }
    92	        while (*fmt >= '0' && *fmt <= '9') width = width * 10 + (*fmt++ - '0');
    93	        if (*fmt == '.') { fmt++; prec = 0; while (*fmt >= '0' && *fmt <= '9') prec = prec * 10 + (*fmt++ - '0'); }
    94	        while (*fmt == 'l' || *fmt == 'z') { longs++; fmt++; }
    95	        digits = "0123456789abcdef";
    96	        switch (*fmt++) {
    97	        case 's': body = va_arg(ap, const char*); if (!body) body = "(null)"; len = (int)strlen(body); if (prec >= 0 && len > prec) len = prec; break;
    98	        case 'c': num[0] = (char)va_arg(ap, int); body = num; len = 1; break;
    99	        case '%': body = "%"; len = 1; break;
   100	        case 'd': case 'i': {
   101	            long long sv = longs >= 2 ? va_arg(ap, long long) : (long long)va_arg(ap, int);
   102	            if (sv < 0) { neg = 1; v = (unsigned long long)(-(sv + 1)) + 1; } else v = (unsigned long long)sv;
   103	            goto number;
   104	        }
   105	        case 'u': v = longs >= 2 ? va_arg(ap, unsigned long long) : (unsigned long long)va_arg(ap, unsigned); goto number;
   106	        case 'X': digits = "0123456789ABCDEF"; /* fallthrough */
   107	        case 'x': v = longs >= 2 ? va_arg(ap, unsigned long long) : (unsigned long long)va_arg(ap, unsigned);
   108	            len = 0; do { num[23 - len++] = digits[v & 15]; v >>= 4; } while (v); body = num + 24 - len; break;
   109	        number:
   110	            len = 0; do { num[23 - len++] = digits[v % 10]; v /= 10; } while (v);
   111	            if (neg) num[23 - len++] = '-';
   112	            body = num + 24 - len; break;
   113	        default: abort(); /* floats and anything else are unsupported on purpose */
   114	        }
   115	        if (!left) while (width > len) { put(k, zero ? "0" : " ", 1); width--; count++; }
   116	        put(k, body, (size_t)len); count += len;
   117	        if (left) while (width > len) { put(k, " ", 1); width--; count++; }
   118	    }
   119	    return count;
   120	}
