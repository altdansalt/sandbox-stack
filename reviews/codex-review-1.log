   147	unsigned long strtoul(const char* s, char** end, int base) {
   148	    unsigned long v = 0;
   149	    if (base == 0) base = 10;
   150	    while (*s == ' ') s++;
   151	    for (;; s++) {
   152	        int d = *s >= '0' && *s <= '9' ? *s - '0' : *s >= 'a' && *s <= 'z' ? *s - 'a' + 10 : *s >= 'A' && *s <= 'Z' ? *s - 'A' + 10 : 99;
