    45	void* memcpy(void* d, const void* s, size_t n) {
    46	    unsigned char* dd = d; const unsigned char* ss = s;
    47	    while (n--) *dd++ = *ss++;
    48	    return d;
    49	}
    50	void* memmove(void* d, const void* s, size_t n) {
    51	    unsigned char* dd = d; const unsigned char* ss = s;
    52	    if (dd < ss) while (n--) *dd++ = *ss++;
    53	    else { dd += n; ss += n; while (n--) *--dd = *--ss; }
    54	    return d;
    55	}
    56	void* memset(void* d, int c, size_t n) {
    57	    unsigned char* dd = d;
    58	    while (n--) *dd++ = (unsigned char)c;
    59	    return d;
    60	}
    61	int memcmp(const void* a, const void* b, size_t n) {
    62	    const unsigned char* x = a; const unsigned char* y = b;
    63	    for (; n; n--, x++, y++) if (*x != *y) return *x - *y;
    64	    return 0;
    65	}
