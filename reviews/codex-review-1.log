    14	static void write_all(int fd, const char* p, size_t n) {
    15	    while (n) { ssize_t w = write(fd, p, n); if (w <= 0) _exit(120); p += w; n -= (size_t)w; }
    16	}
    17	
    18	FILE* fopen(const char* path, const char* mode) {
    19	    FILE* f = calloc(1, sizeof *f);
    20	    if (!f) return NULL;
    21	    f->fd = -1;
    22	    f->name = malloc(strlen(path) + 1);
    23	    strcpy(f->name, path);
    24	    if (mode[0] == 'r') {            /* the single input: slurp stdin */
    25	        f->cap = 65536; f->buf = malloc(f->cap);
    26	        for (;;) {
    27	            ssize_t n;
    28	            if (f->len == f->cap) { f->cap *= 2; f->buf = realloc(f->buf, f->cap); }
    29	            n = read(0, f->buf + f->len, f->cap - f->len);
    30	            if (n < 0) return NULL;
    31	            if (n == 0) break;
    32	            f->len += (size_t)n;
    33	        }
    34	    } else {
    35	        f->out = 1; f->cap = 65536; f->buf = malloc(f->cap);
    36	    }
    37	    return f;
    38	}
    39	size_t fwrite(const void* p, size_t sz, size_t n, FILE* f) {
    40	    size_t total = sz * n;
    41	    if (f->fd >= 0) { write_all(f->fd, p, total); return n; }
    42	    if (!f->out) return 0;
    43	    while (f->len + total > f->cap) { f->cap *= 2; f->buf = realloc(f->buf, f->cap); }
    44	    memcpy(f->buf + f->len, p, total);
    45	    f->len += total;
    46	    return n;
    47	}
    48	size_t fread(void* p, size_t sz, size_t n, FILE* f) {
    49	    size_t total = sz * n;
    50	    if (f->fd >= 0 || f->out) return 0;
    51	    if (total > f->len - f->pos) total = f->len - f->pos;
    52	    memcpy(p, f->buf + f->pos, total);
    53	    f->pos += total;
    54	    return total / sz;
    55	}
    56	int fseek(FILE* f, long off, int whence) {
    57	    size_t base = whence == SEEK_SET ? 0 : whence == SEEK_CUR ? f->pos : f->len;
    58	    f->pos = base + (size_t)off;
    59	    return 0;
    60	}
    61	long ftell(FILE* f) { return (long)f->pos; }
    62	void rewind(FILE* f) { f->pos = 0; }
    63	int fclose(FILE* f) {
