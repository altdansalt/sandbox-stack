        MUST (wasmCWriteComma(writer))
        MUST (wasmCWriteStringStackName(
            writer->builder,
            stackIndex0,
            writer->typeStack->valueTypes[stackIndex0]
        ))
        MUST (wasmCWrite(writer, ");\n"))


