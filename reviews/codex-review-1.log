     7	/* bump allocator over linear memory; grows with memory.grow; free is a no-op.
     8	   A 16-byte header stores the block size so realloc can copy exactly. */
     9	extern unsigned char __heap_base;
    10	static size_t heap_top;
    11	
    12	void* malloc(size_t n) {
    13	    size_t cur, top, end;
    14	    if (!heap_top) heap_top = ((size_t)&__heap_base + 15) & ~(size_t)15;
    15	    n = (n + 15) & ~(size_t)15;
    16	    cur = heap_top;
    17	    top = cur + 16 + n;
    18	    if (top < cur) return NULL;
    19	    end = (size_t)__builtin_wasm_memory_size(0) << 16;
    20	    if (top > end) {
    21	        size_t need = (top - end + 65535) >> 16;
    22	        if (__builtin_wasm_memory_grow(0, need) == (size_t)-1) return NULL;
    23	    }
    24	    heap_top = top;
    25	    *(size_t*)cur = n;
    26	    return (void*)(cur + 16);
    27	}
    28	void* calloc(size_t n, size_t m) {
    29	    void* p = malloc(n * m);
    30	    if (p) memset(p, 0, n * m);
    31	    return p;
    32	}
    33	void* realloc(void* p, size_t n) {
    34	    void* q;
    35	    size_t old;
    36	    if (!p) return malloc(n);
    37	    old = *(size_t*)((char*)p - 16);
    38	    if (n <= old) return p;
    39	    q = malloc(n);
    40	    if (q) memcpy(q, p, old);
    41	    return q;
    42	}
    43	void free(void* p) { (void)p; }
