    65	    if (f->out) {
    66	        char hdr[64];
    67	        sprintf(hdr, "@@FILE %s %lu\n", f->name, (unsigned long)f->len);
    68	        write_all(1, hdr, strlen(hdr));
    69	        write_all(1, f->buf, f->len);
    70	    }
    71	    return 0;
    72	}
