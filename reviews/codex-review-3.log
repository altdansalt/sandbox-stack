      static char *stems[] = {"mov","add","sub","and","cmp","xor","or","test","imul","idiv","div","neg","not","shl","shr","sar","push","pop","lea","inc","dec"};
      for (int i = 0; i < sizeof(stems) / sizeof(*stems); i++)
