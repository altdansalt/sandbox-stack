  if (n == 0) {
    if (!strcmp(mn, "ret")) { emit8(0xC3); return; }
    if (!strcmp(mn, "cqo") || !strcmp(mn, "cqto")) { emit8(0x48); emit8(0x99); return; }
    if (!strcmp(mn, "cdq") || !strcmp(mn, "cltd")) { emit8(0x99); return; }
