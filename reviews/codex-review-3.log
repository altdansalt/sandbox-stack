   263	        emit8(0x48 | (dst->reg >= 8 ? 1 : 0)); emit8(0xB8 + (dst->reg & 7)); emit64((uint64_t)src->imm); return; }
   264	      if (size == 8) { e.w = true; e.op[0] = 0xC7; e.oplen = 1; e.reg = 0; e.rm = dst; e.imm_size = 4; e.imm = src->imm; encode(&e); return; }
   265	      // B0+r / B8+r
   266	      if (size == 1) { if (!fits8(src->imm) && src->imm > 255) asm_error("immediate too large"); }
   267	      if (size == 2) e.opsize16 = true;
   268	      int rex = 0x40 | (dst->reg >= 8 ? 1 : 0);
   269	      if (rex != 0x40 || (size == 1 && dst->reg >= 4 && dst->reg <= 7 && !dst->high8)) emit8(rex);
   270	      if (e.opsize16) emit8(0x66);
   271	      emit8((size == 1 ? 0xB0 : 0xB8) + (dst->reg & 7));
   272	      if (size == 1) emit8(src->imm & 0xff); else if (size == 2) { emit8(src->imm & 0xff); emit8((src->imm >> 8) & 0xff); } else emit32((uint32_t)src->imm);
   273	      return;
   274	    }
   275	    if (dst->kind == O_MEM) {
   276	      set_size(&e, size, 0xC6, 0xC7); e.reg = 0; e.rm = dst; e.imm_size = size == 8 ? 4 : size == 2 ? 2 : size; e.imm = src->imm;
   277	      if (size == 8 && !fits32(src->imm)) asm_error("immediate too large for memory store");
   278	      encode(&e); return;
   279	    }
   280	  }
   281	  if (src->kind == O_REG && (dst->kind == O_REG || dst->kind == O_MEM)) {
   282	    set_size(&e, size, 0x88, 0x89); e.reg = src->reg; e.rm = dst; need_rex_for(&e, src); need_rex_for(&e, dst); encode(&e); return;
   283	  }
   284	  if (src->kind == O_MEM && dst->kind == O_REG) {
   285	    if (src->gotpcrel) { if (size != 8) asm_error("GOTPCREL load into a non-64-bit register"); e.op[0] = 0x8D; e.oplen = 1; e.w = true; e.reg = dst->reg; e.rm = src; encode(&e); return; }
   286	    set_size(&e, size, 0x8A, 0x8B); e.reg = dst->reg; e.rm = src; need_rex_for(&e, dst); encode(&e); return;
   287	  }
   288	  asm_error("unsupported mov operands");
   289	}
   290	
   291	// movs*/movz* family: mnemonic gives sign and source width; destination width from register
   292	static void movx(char *mn, Op *src, Op *dst) {
   293	  bool sign = mn[3] == 's';
   294	  int srcsize;
   295	  char *rest = mn + 4;   // after "movs"/"movz"
   296	  if (!strcmp(mn, "movsxd") || !strcmp(mn, "movslq")) srcsize = 4;
   297	  else if (*rest == 'b') srcsize = 1;
   298	  else if (*rest == 'w') srcsize = 2;
   299	  else if (*rest == 'x' || *rest == 0) { // movzx / movzb without suffix: source size from register
   300	    if (src->kind != O_REG) asm_error("%s needs a register source", mn); srcsize = src->size;
   301	  } else asm_error("unknown extension %s", mn);
   302	  if (dst->kind != O_REG) asm_error("%s needs a register destination", mn);
   303	  Enc e = {0};
   304	  if (srcsize == 4) { e.w = true; e.op[0] = 0x63; e.oplen = 1; }
   305	  else { e.op[0] = 0x0F; e.op[1] = (sign ? 0xBE : 0xB6) + (srcsize == 2 ? 1 : 0); e.oplen = 2; e.w = dst->size == 8; e.opsize16 = dst->size == 2; }
   306	  e.reg = dst->reg; e.rm = src; need_rex_for(&e, src);
   307	  encode(&e);
   308	}
   309	
   310	static int cc_code(char *s) {
   311	  static struct { char *n; int c; } t[] = {
   312	    {"o",0},{"no",1},{"b",2},{"c",2},{"nae",2},{"ae",3},{"nb",3},{"e",4},{"z",4},{"ne",5},{"nz",5},{"be",6},{"na",6},
   313	    {"a",7},{"nbe",7},{"s",8},{"ns",9},{"p",10},{"np",11},{"l",12},{"ge",13},{"le",14},{"g",15},
   314	  };
   315	  for (int i = 0; i < sizeof(t) / sizeof(*t); i++) if (!strcmp(t[i].n, s)) return t[i].c;
   316	  return -1;
   317	}
   318	
   319	static void sse(int prefix, uint8_t op, Op *src, Op *dst, bool w, bool xmm_in_reg_field_is_dst) {
   320	  // generic "op xmm/m, xmm" form: reg field = dst xmm, rm = src
   321	  Enc e = {0};
   322	  e.prefix = prefix; e.op[0] = 0x0F; e.op[1] = op; e.oplen = 2; e.w = w;
   323	  if (xmm_in_reg_field_is_dst) { e.reg = dst->reg; e.rm = src; }
   324	  else { e.reg = src->reg; e.rm = dst; }
   325	  encode(&e);
   326	}
   327	
   328	static void instruction(char *mn, char *rest) {
   329	  Op ops[3]; int n = 0;
   330	  if (rest && *rest) {
   331	    char *p = rest;
   332	    while (n < 3) {
   333	      char *comma = strchr(p, ',');
   334	      if (comma) *comma = 0;
   335	      ops[n++] = parse_op(p);
   336	      if (!comma) break;
   337	      p = comma + 1;
   338	    }
   339	  }
   340	  Op *a = n > 0 ? &ops[0] : NULL, *b = n > 1 ? &ops[1] : NULL;
   341	  size_t L = strlen(mn);
   342	  char suffix = 0;
   343	
   344	  // prefixes
   345	  if (!strcmp(mn, "rep")) {
   346	    if (!strcmp(trim(rest), "stosb")) { emit8(0xF3); emit8(0xAA); return; }
   347	    asm_error("unsupported rep instruction");
   348	  }
   349	  if (!strcmp(mn, "lock") || !strcmp(mn, "data16") || !strcmp(mn, "rex64")) asm_error("atomics/TLS are not supported");
   350	
   351	  // no-operand instructions
   352	  if (n == 0) {
   353	    if (!strcmp(mn, "ret")) { emit8(0xC3); return; }
   354	    if (!strcmp(mn, "cqo") || !strcmp(mn, "cqto")) { emit8(0x48); emit8(0x99); return; }
   355	    if (!strcmp(mn, "cdq") || !strcmp(mn, "cltd")) { emit8(0x99); return; }
   356	    if (!strcmp(mn, "syscall")) { emit8(0x0F); emit8(0x05); return; }
   357	    if (!strcmp(mn, "hlt")) { emit8(0xF4); return; }
   358	    if (!strcmp(mn, "nop")) { emit8(0x90); return; }
   359	    if (mn[0] == 'f') asm_error("x87 (long double) is not supported");
   360	    asm_error("unknown instruction %s", mn);
   361	  }
   362	
   363	  // control flow
   364	  if (!strcmp(mn, "jmp") || !strcmp(mn, "call")) {
   365	    if (a->kind == O_LABEL) { emit8(!strcmp(mn, "jmp") ? 0xE9 : 0xE8); add_fixup(a->sym, -4, false); emit32(0); return; }
   366	    if (a->kind == O_REG && a->size == 8) { Enc e = {0}; e.op[0] = 0xFF; e.oplen = 1; e.reg = !strcmp(mn, "jmp") ? 4 : 2; e.rm = a; encode(&e); return; }
   367	    asm_error("bad %s operand", mn);
   368	  }
   369	  if (mn[0] == 'j' && a->kind == O_LABEL) {
   370	    int cc = cc_code(mn + 1);
   371	    if (cc < 0) asm_error("unknown jump %s", mn);
   372	    emit8(0x0F); emit8(0x80 + cc); add_fixup(a->sym, -4, false); emit32(0); return;
   373	  }
   374	  if (!strncmp(mn, "set", 3) && n == 1) {
   375	    int cc = cc_code(mn + 3);
   376	    if (cc < 0 || a->kind != O_REG || a->size != 1) asm_error("bad setcc");
   377	    Enc e = {0}; e.op[0] = 0x0F; e.op[1] = 0x90 + cc; e.oplen = 2; e.reg = 0; e.rm = a; need_rex_for(&e, a); encode(&e); return;
   378	  }
   379	
   380	  // SSE
   381	  if (!strcmp(mn, "movss") || !strcmp(mn, "movsd")) {
   382	    int pfx = mn[4] == 's' ? 0xF3 : 0xF2;
   383	    if (b->kind == O_REG && b->xmm) { sse(pfx, 0x10, a, b, false, true); return; }       // load / reg-reg
   384	    if (a->kind == O_REG && a->xmm && b->kind == O_MEM) { sse(pfx, 0x11, a, b, false, false); return; } // store
   385	    asm_error("bad %s operands", mn);
   386	  }
   387	  if (!strcmp(mn, "movq") && ((a->kind == O_REG && a->xmm) || (b->kind == O_REG && b->xmm))) {
   388	    if (b->xmm) { Enc e = {0}; e.prefix = 0x66; e.w = true; e.op[0] = 0x0F; e.op[1] = 0x6E; e.oplen = 2; e.reg = b->reg; e.rm = a; encode(&e); return; }
   389	    Enc e = {0}; e.prefix = 0x66; e.w = true; e.op[0] = 0x0F; e.op[1] = 0x7E; e.oplen = 2; e.reg = a->reg; e.rm = b; encode(&e); return;
   390	  }
   391	  if (!strncmp(mn, "cvtsi2s", 7)) {  // cvtsi2ss[lq] / cvtsi2sd[lq]: int -> float
   392	    int pfx = mn[7] == 's' ? 0xF3 : 0xF2;
   393	    bool w = mn[8] == 'q' || (mn[8] == 0 && a->kind == O_REG && a->size == 8);
   394	    sse(pfx, 0x2A, a, b, w, true); return;
   395	  }
   396	  if (!strncmp(mn, "cvtts", 5)) {    // cvttss2si[lq] / cvttsd2si[lq]: float -> int
   397	    int pfx = mn[5] == 's' ? 0xF3 : 0xF2;
   398	    bool w = b->size == 8;
   399	    Enc e = {0}; e.prefix = pfx; e.op[0] = 0x0F; e.op[1] = 0x2C; e.oplen = 2; e.w = w; e.reg = b->reg; e.rm = a; encode(&e); return;
   400	  }
   401	  if (!strcmp(mn, "cvtss2sd")) { sse(0xF3, 0x5A, a, b, false, true); return; }
   402	  if (!strcmp(mn, "cvtsd2ss")) { sse(0xF2, 0x5A, a, b, false, true); return; }
   403	  if (!strcmp(mn, "ucomiss")) { sse(0, 0x2E, a, b, false, true); return; }
   404	  if (!strcmp(mn, "ucomisd")) { sse(0x66, 0x2E, a, b, false, true); return; }
   405	  if (!strcmp(mn, "xorps")) { sse(0, 0x57, a, b, false, true); return; }
   406	  if (!strcmp(mn, "xorpd")) { sse(0x66, 0x57, a, b, false, true); return; }
   407	  if (!strcmp(mn, "pxor")) { sse(0x66, 0xEF, a, b, false, true); return; }
   408	  {
   409	    static struct { char *n; int op; } arith[] = {{"add",0x58},{"mul",0x59},{"sub",0x5C},{"div",0x5E}};
   410	    for (int i = 0; i < 4; i++)
   411	      if (!strncmp(mn, arith[i].n, 3) && L == 5 && mn[3] == 's' && (mn[4] == 's' || mn[4] == 'd')) {
   412	        sse(mn[4] == 's' ? 0xF3 : 0xF2, arith[i].op, a, b, false, true); return;
   413	      }
   414	  }
   415	  if (mn[0] == 'f') asm_error("x87 (long double) is not supported");
   416	
   417	  // movs*/movz*
   418	  if (!strncmp(mn, "movs", 4) || !strncmp(mn, "movz", 4)) {
   419	    if (n != 2) asm_error("bad %s", mn);
   420	    if (!strcmp(mn, "movsd") || !strcmp(mn, "movss")) asm_error("unreachable");
   421	    movx(mn, a, b); return;
   422	  }
   423	
   424	  // integer mov / alu with optional size suffix
   425	  char stem[16];
   426	  strcpy(stem, mn);
   427	  if (L > 3 && strchr("bwlq", mn[L - 1]) && (!strncmp(mn, "mov", 3) || !strncmp(mn, "add", 3) || !strncmp(mn, "sub", 3) ||
   428	      !strncmp(mn, "and", 3) || !strncmp(mn, "cmp", 3) || !strncmp(mn, "xor", 3) || !strncmp(mn, "or", 2) ||
   429	      !strncmp(mn, "test", 4) || !strncmp(mn, "imul", 4) || !strncmp(mn, "idiv", 4) || !strncmp(mn, "div", 3) ||
   430	      !strncmp(mn, "neg", 3) || !strncmp(mn, "not", 3) || !strncmp(mn, "shl", 3) || !strncmp(mn, "shr", 3) || !strncmp(mn, "sar", 3) ||
   431	      !strncmp(mn, "push", 4) || !strncmp(mn, "pop", 3) || !strncmp(mn, "lea", 3) || !strncmp(mn, "inc", 3) || !strncmp(mn, "dec", 3))) {
   432	    if (strcmp(mn, "mul") && strcmp(mn, "shl") && strcmp(mn, "shr") && strcmp(mn, "sarl") ) {
   433	      // only strip when the stem is a known mnemonic (avoid "mul"->"mu")
   434	      static char *stems[] = {"mov","add","sub","and","cmp","xor","or","test","imul","idiv","div","neg","not","shl","shr","sar","push","pop","lea","inc","dec"};
   435	      for (int i = 0; i < sizeof(stems) / sizeof(*stems); i++)
   436	        if (strlen(stems[i]) == L - 1 && !strncmp(mn, stems[i], L - 1)) { suffix = mn[L - 1]; stem[L - 1] = 0; break; }
   437	    }
   438	  }
   439	  mn = stem;
   440	
   441	  if (!strcmp(mn, "mov")) { if (n != 2) asm_error("bad mov"); mov(a, b, suffix); return; }
   442	  if (!strcmp(mn, "lea")) {
   443	    if (n != 2 || a->kind != O_MEM || b->kind != O_REG) asm_error("bad lea");
   444	    Enc e = {0}; e.op[0] = 0x8D; e.oplen = 1; e.w = b->size == 8; e.opsize16 = b->size == 2; e.reg = b->reg; e.rm = a; encode(&e); return;
   445	  }
   446	  {
   447	    static struct { char *n; int g; } g1[] = {{"add",0},{"or",1},{"and",4},{"sub",5},{"xor",6},{"cmp",7}};
   448	    for (int i = 0; i < 6; i++) if (!strcmp(mn, g1[i].n)) { if (n != 2) asm_error("bad %s", mn); alu(g1[i].g, a, b, suffix); return; }
   449	  }
   450	  if (!strcmp(mn, "test")) {
   451	    if (n != 2 || a->kind != O_REG) asm_error("bad test");
   452	    Enc e = {0}; int size = op_size(a, b, suffix); set_size(&e, size, 0x84, 0x85); e.reg = a->reg; e.rm = b; need_rex_for(&e, a); need_rex_for(&e, b); encode(&e); return;
   453	  }
   454	  if (!strcmp(mn, "push") || !strcmp(mn, "pop")) {
   455	    if (n != 1 || a->kind != O_REG || a->size != 8) asm_error("bad %s", mn);
   456	    if (a->reg >= 8) emit8(0x41);
   457	    emit8((!strcmp(mn, "push") ? 0x50 : 0x58) + (a->reg & 7)); return;
   458	  }
   459	  if (!strcmp(mn, "imul")) {
   460	    if (n != 2 || b->kind != O_REG) asm_error("bad imul");
   461	    Enc e = {0}; e.op[0] = 0x0F; e.op[1] = 0xAF; e.oplen = 2; e.w = b->size == 8; e.opsize16 = b->size == 2; e.reg = b->reg; e.rm = a; encode(&e); return;
   462	  }
   463	  {
   464	    static struct { char *n; int g; } g3[] = {{"not",2},{"neg",3},{"mul",4},{"imul",5},{"div",6},{"idiv",7}};
   465	    for (int i = 0; i < 6; i++) if (!strcmp(mn, g3[i].n)) {
   466	      if (n != 1) asm_error("bad %s", mn);
   467	      Enc e = {0}; int size = op_size(a, NULL, suffix); set_size(&e, size, 0xF6, 0xF7); e.reg = g3[i].g; e.rm = a; need_rex_for(&e, a); encode(&e); return;
   468	    }
   469	  }
   470	  if (!strcmp(mn, "inc") || !strcmp(mn, "dec")) {
   471	    if (n != 1) asm_error("bad %s", mn);
   472	    Enc e = {0}; int size = op_size(a, NULL, suffix); set_size(&e, size, 0xFE, 0xFF); e.reg = !strcmp(mn, "inc") ? 0 : 1; e.rm = a; need_rex_for(&e, a); encode(&e); return;
   473	  }
   474	  {
   475	    static struct { char *n; int g; } sh[] = {{"shl",4},{"shr",5},{"sar",7},{"sal",4}};
   476	    for (int i = 0; i < 4; i++) if (!strcmp(mn, sh[i].n)) {
   477	      Enc e = {0};
   478	      Op *dst = n == 2 ? b : a;
   479	      int size = op_size(dst, NULL, suffix);
   480	      if (n == 2 && a->kind == O_REG && a->reg == 1 && a->size == 1) { set_size(&e, size, 0xD2, 0xD3); e.reg = sh[i].g; e.rm = dst; need_rex_for(&e, dst); encode(&e); return; }
   481	      if (n == 2 && a->kind == O_IMM) { set_size(&e, size, 0xC0, 0xC1); e.reg = sh[i].g; e.rm = dst; e.imm_size = 1; e.imm = a->imm; need_rex_for(&e, dst); encode(&e); return; }
   482	      if (n == 1) { set_size(&e, size, 0xD0, 0xD1); e.reg = sh[i].g; e.rm = dst; need_rex_for(&e, dst); encode(&e); return; }
   483	      asm_error("bad shift");
   484	    }
   485	  }
   486	  if (!strcmp(mn, "xchg") || !strcmp(mn, "cmpxchg")) asm_error("atomics are not supported");
   487	  asm_error("unknown instruction %s", mn);
   488	}
   489	
   490	static void directive(char *d, char *rest) {
   491	  if (!strcmp(d, ".text")) { cur = &text; cur_bss = false; return; }
   492	  if (!strcmp(d, ".data")) { cur = &data; cur_bss = false; return; }
   493	  if (!strcmp(d, ".bss")) { cur = &data; cur_bss = true; return; }
   494	  if (!strcmp(d, ".section")) {
   495	    rest = trim(rest);
   496	    if (!strncmp(rest, ".text", 5)) { cur = &text; cur_bss = false; return; }
   497	    if (!strncmp(rest, ".data", 5)) { cur = &data; cur_bss = false; return; }
   498	    if (!strncmp(rest, ".bss", 4)) { cur = &data; cur_bss = true; return; }
   499	    asm_error("unsupported section %s (TLS?)", rest);
   500	  }
   501	  if (!strcmp(d, ".globl") || !strcmp(d, ".local") || !strcmp(d, ".type") || !strcmp(d, ".size") ||
   502	      !strcmp(d, ".file") || !strcmp(d, ".loc")) return;
   503	  if (!strcmp(d, ".align")) {
   504	    long a = strtol(rest, NULL, 10);
   505	    if (a <= 0 || (a & (a - 1))) asm_error("bad alignment");
   506	    if (cur_bss) { bss_len = align_to(bss_len, a); return; }
   507	    while (cur->len % a) emit8(cur == &text ? 0x90 : 0);
   508	    return;
   509	  }
   510	  if (cur_bss && (!strcmp(d, ".byte") || !strcmp(d, ".quad"))) asm_error("data in .bss");
   511	  if (!strcmp(d, ".byte")) { long v = strtol(rest, NULL, 10); emit8((int)v & 0xff); return; }
   512	  if (!strcmp(d, ".zero")) { long v = strtol(rest, NULL, 10); if (cur_bss) bss_len += v; else for (long i = 0; i < v; i++) emit8(0); return; }
   513	  if (!strcmp(d, ".quad")) {
   514	    rest = trim(rest);
   515	    if (isdigit(*rest) || *rest == '-') { emit64((uint64_t)strtoll(rest, NULL, 10)); return; }
   516	    char *plus = strpbrk(rest, "+-");
   517	    long addend = 0;
   518	    if (plus) { addend = strtol(plus, NULL, 10); *plus = 0; }
   519	    add_fixup(strdup(trim(rest)), addend, true);
   520	    emit64(0);
   521	    return;
   522	  }
   523	  if (!strcmp(d, ".comm")) {  // .comm name, size, align
   524	    char *name = strtok(rest, ","); char *sz = strtok(NULL, ","); char *al = strtok(NULL, ",");
   525	    if (!name || !sz || !al) asm_error("bad .comm");
   526	    long size = strtol(sz, NULL, 10), a = strtol(al, NULL, 10);
   527	    bss_len = align_to(bss_len, a);
   528	    Sym *s = calloc(1, sizeof(Sym)); s->sec = 2; s->off = bss_len;
   529	    hashmap_put(&syms, strdup(trim(name)), s);
   530	    bss_len += size;
   531	    return;
   532	  }
   533	  asm_error("unknown directive %s", d);
   534	}
   535	
   536	static void assemble_line(char *line) {
   537	  cur_line = line;
   538	  char *s = trim(line);
   539	  if (!*s) return;
   540	  // label?
   541	  size_t L = strlen(s);
   542	  if (s[L - 1] == ':') {
   543	    s[L - 1] = 0;
   544	    if (isdigit(*s) && !s[1]) { int k = ++numeric_count[*s - '0']; define_sym(numeric_name(*s - '0', k)); return; }
   545	    define_sym(strdup(s));
   546	    return;
   547	  }
   548	  char *sp = s;
   549	  while (*sp && !isspace(*sp)) sp++;
   550	  char *rest = *sp ? sp + 1 : sp;
   551	  *sp = 0;
   552	  if (*s == '.') directive(s, rest);
   553	  else if (cur_bss) asm_error("instruction in .bss");
   554	  else instruction(s, rest);
   555	}
   556	
   557	// ---- ELF ----
   558	#define BASE 0x400000UL
   559	#define PAGE 0x1000UL
   560	
   561	static void put16(uint8_t *p, uint64_t v) { for (int i = 0; i < 2; i++) p[i] = (v >> (8 * i)) & 0xff; }
   562	static void put32(uint8_t *p, uint64_t v) { for (int i = 0; i < 4; i++) p[i] = (v >> (8 * i)) & 0xff; }
   563	static void put64(uint8_t *p, uint64_t v) { for (int i = 0; i < 8; i++) p[i] = (v >> (8 * i)) & 0xff; }
   564	
   565	void assemble_elf(char *asm_text, FILE *out) {
   566	  cur = &text; cur_bss = false;
   567	  char *p = asm_text;
   568	  line_no = 0;
   569	  while (*p) {
   570	    char *nl = strchr(p, '\n');
   571	    if (nl) *nl = 0;
   572	    line_no++;
