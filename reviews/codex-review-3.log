    43	static void parse_args(int argc, char **argv) {
    44	  for (int i = 1; i < argc; i++) {
    45	    if (!strcmp(argv[i], "-o")) { if (!argv[++i]) usage(1); opt_o = argv[i]; continue; }
    46	    if (!strncmp(argv[i], "-o", 2)) { opt_o = argv[i] + 2; continue; }
    47	    if (!strcmp(argv[i], "-E")) { opt_E = true; continue; }
    48	    if (!strcmp(argv[i], "-I")) { if (!argv[++i]) usage(1); strarray_push(&include_paths, argv[i]); continue; }
    49	    if (!strncmp(argv[i], "-I", 2)) { strarray_push(&include_paths, argv[i] + 2); continue; }
    50	    if (!strcmp(argv[i], "-D")) { if (!argv[++i]) usage(1); define_arg(argv[i]); continue; }
    51	    if (!strncmp(argv[i], "-D", 2)) { define_arg(argv[i] + 2); continue; }
    52	    if (!strncmp(argv[i], "-mstack=", 8)) { opt_stack_size = parse_num(argv[i] + 8, 16, 1 << 30, "-mstack"); continue; }
    53	    if (!strncmp(argv[i], "-mmaxpages=", 11)) { opt_max_pages = parse_num(argv[i] + 11, 1, 65536, "-mmaxpages"); continue; }
