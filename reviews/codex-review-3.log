  }
  {
    static struct { char *n; int g; } g1[] = {{"add",0},{"or",1},{"and",4},{"sub",5},{"xor",6},{"cmp",7}};
    for (int i = 0; i < 6; i++) if (!strcmp(mn, g1[i].n)) { if (n != 2) asm_error("bad %s", mn); alu(g1[i].g, a, b, suffix); return; }
