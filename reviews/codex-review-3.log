    Enc e = {0}; e.prefix = 0x66; e.w = true; e.op[0] = 0x0F; e.op[1] = 0x7E; e.oplen = 2; e.reg = a->reg; e.rm = b; encode(&e); return;
  }
  if (!strncmp(mn, "cvtsi2s", 7)) {  // cvtsi2ss[lq] / cvtsi2sd[lq]: int -> float
    int pfx = mn[7] == 's' ? 0xF3 : 0xF2;
