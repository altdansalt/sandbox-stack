      if (n == 2 && a->kind == O_REG && a->reg == 1 && a->size == 1) { set_size(&e, size, 0xD2, 0xD3); e.reg = sh[i].g; e.rm = dst; need_rex_for(&e, dst); encode(&e); return; }
